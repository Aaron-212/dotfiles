{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "secondary_prompt": {
    "template": "::> "
  },
  "console_title_template": "{{ .UserName }}@{{ .HostName }}  -{{ .Shell }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "powerline",
          "template": "{{ if .Root }}!{{else}} {{ end }}{{ .Name }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "darkGray",
          "type": "shell",
          "leading_powerline_symbol": "\ue0b6",
          "background_templates": ["{{ if .Root }}red{{ end }}"]
        },
        {
          "properties": {
            "folder_separator_icon": "/",
            "home_icon": "~",
            "max_width": 20,
            "style": "powerlevel"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "cyan",
          "type": "path"
        },
        {
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "darkGray",
          "type": "git",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}blue{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}magenta{{ end }}",
            "{{ if gt .Ahead 0 }}green{{ end }}",
            "{{ if gt .Behind 0 }}red{{ end }}"
          ]
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "style": "austin"
          },
          "style": "powerline",
          "template": " {{ if gt .Ms 100 }}{{ if gt .Code 0 }}E{{ .Code }} {{ .FormattedMs }}{{ else }}{{ .FormattedMs }}{{ end }}{{ else }}{{ if gt .Code 0 }}E{{ .Code }}{{ else }}OK{{ end }}{{ end }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "blue",
          "type": "executiontime",
          "background_templates": ["{{ if gt .Code 0 }}red{{ else }}green{{ end }}"],
          "invert_powerline": true
        },
        {
          "style": "powerline",
          "template": " nodejs@{{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "cyan",
          "type": "node",
          "invert_powerline": true
        },
        {
          "style": "powerline",
          "template": " rust@{{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "yellow",
          "type": "rust",
          "invert_powerline": true
        },
        {
          "properties": {
            "display_mode": "environment"
          },
          "style": "powerline",
          "template": " envPy@{{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b2",
          "background": "blue",
          "type": "python",
          "invert_powerline": true
        },
        {
          "properties": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#ffffff",
          "background": "darkGray",
          "type": "time",
          "invert_powerline": true
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
