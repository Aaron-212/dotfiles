[user]
	name = Aaron Ruan
	email = me@aaron212.com
	signingKey = /Users/aaron212/.ssh/id_ecdsa_sk_rk_ssh.pub
	useConfigOnly = true

[commit]
	gpgsign = true

[core]
	editor = edit
	quotepath = false
	longpaths = true
	autocrlf = input
	trustctime = false
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes_global
	ignorecase = true
	untrackedcache = true
	pager = less --mouse --wheel-lines=1

[color]
	ui = auto

[diff "text"]
	textconv = cat

[mergetool]
	keepBackup = false

[lfs]
	concurrenttransfers = 16
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3

[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2

[rebase]
	backend = merge

[pull]
	rebase = true

[safe]
	directory = *

[push]
	autoSetupRemote = true

[gpg]
	format = ssh

[format]
	signoff = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
	safe-push = push --force-if-includes
	please = push --force-with-lease
	pfwl = push --force-with-lease
[merge]
	tool = opendiff
[mergetool "opendiff"]
	trustExitCode = true
[init]
	defaultBranch = main
[http]
	postBuffer = 655360000
[merge "lfs-text"]
	driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A --program 'git merge-file --stdout --marker-size=%%L %%A %%O %%B >%%D'
[protocol]
	version = 1
[includeIf "gitdir:/Users/aaron212/Repos/baosight/"]
	path = /Users/aaron212/Repos/baosight/.gitconfig
